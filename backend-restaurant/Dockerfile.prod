# ==============================================================================
# Production Dockerfile for Laravel Backend (backend-restaurant)
# ==============================================================================
FROM php:8.4-fpm-alpine

WORKDIR /var/www

# Install runtime and build dependencies
RUN apk add --no-cache \
    curl \
    git \
    unzip \
    libpq-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    linux-headers \
    supervisor \
    bash \
    netcat-openbsd \
    $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_pgsql \
        pgsql \
        intl \
        zip \
        bcmath \
        exif \
        pcntl \
        gd \
        opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS \
    && rm -rf /tmp/pear

# Install Composer
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer

# Production PHP & Opcache settings (Low Resource / VPS Optimized)
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.enable_cli=1'; \
    echo 'opcache.memory_consumption=64'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=10000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.fast_shutdown=1'; \
    echo 'upload_max_filesize=32M'; \
    echo 'post_max_size=32M'; \
    echo 'memory_limit=128M'; \
    echo 'expose_php=Off'; \
} > /usr/local/etc/php/conf.d/production.ini

# PHP-FPM pool optimization for low-memory VPS (pm = ondemand, max 4 workers)
RUN { \
    echo '[www]'; \
    echo 'pm = ondemand'; \
    echo 'pm.max_children = 4'; \
    echo 'pm.process_idle_timeout = 10s'; \
    echo 'pm.max_requests = 200'; \
} > /usr/local/etc/php-fpm.d/zz-low-resource.conf

# Copy application source
COPY . .

# Install production PHP dependencies
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

# Ensure proper storage & cache permissions
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache && \
    chmod -R 775 /var/www/storage /var/www/bootstrap/cache

# Production entrypoint script
COPY deploy/entrypoint-prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 9000

CMD ["/entrypoint.sh"]


# ==============================================================================
# Production Environment Variables (.env.production)
# ==============================================================================

# Container Registry & Repository (for pulling prebuilt CI/CD images)
CONTAINER_REGISTRY=ghcr.io
GITHUB_REPOSITORY=wildanbelfiore/moc_test
IMAGE_TAG=latest

# Application Ports
HTTP_PORT=80
HTTPS_PORT=443

# Laravel Backend Config
APP_NAME="PADA Resto"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_TIMEZONE=Asia/Jakarta

# PostgreSQL Production Credentials
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=db_moc
DB_USERNAME=root
DB_PASSWORD=manchester_secure_password_here

# Redis Cache & Queue
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Real-time WebSocket (PieSocket)
PIESOCKET_CLUSTER_ID=free.blr2
PIESOCKET_API_KEY=F6y6bNEzxhFn3gkxubwElu1KPdFHuRKzICDsfPO9
PIESOCKET_API_SECRET=Tsi2GnghMJFvYtBnm7n1T9SxvgFVOD67
PIESOCKET_CHANNEL_ID=1
PIESOCKET_WS_URL="wss://free.blr2.piesocket.com/v3/1?api_key=F6y6bNEzxhFn3gkxubwElu1KPdFHuRKzICDsfPO9&notify_self=1"

# Next.js Frontend Config
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_PIESOCKET_CLUSTER_ID=free.blr2
NEXT_PUBLIC_PIESOCKET_API_KEY=F6y6bNEzxhFn3gkxubwElu1KPdFHuRKzICDsfPO9
NEXT_PUBLIC_PIESOCKET_CHANNEL_ID=1
NEXT_PUBLIC_PIESOCKET_WS_URL="wss://free.blr2.piesocket.com/v3/1?api_key=F6y6bNEzxhFn3gkxubwElu1KPdFHuRKzICDsfPO9&notify_self=1"

